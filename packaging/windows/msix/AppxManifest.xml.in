<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package. build-msix.ps1 fills in @NAME@, @PUBLISHER@,
     @PUBLISHER_DISPLAY_NAME@, @VERSION@ and @ARCH@ (x64 or arm64). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>DeltaView</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- No VCLibs framework dependency: build-msix.ps1 puts the Visual C++ runtime
       DLLs of the compiler that built delta_view.exe next to it in the package. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeltaView" Executable="delta_view.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeltaView"
        Description="Compare folders and files side by side, merge changes and sync folders: on this PC, in zip and tar archives, and on SFTP servers."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- `delta-view` in a terminal, as in docs/command-line.md. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="delta_view.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="delta-view.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Connections to the SFTP servers the user opens. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
