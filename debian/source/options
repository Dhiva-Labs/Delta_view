# Generated by `flutter pub get`: they hold symlinks into the local user's
# ~/.pub-cache, which must not end up in a source tarball that Launchpad's
# builders unpack somewhere else. debian/rules regenerates them.
tar-ignore = "linux/flutter/ephemeral"
tar-ignore = "windows/flutter/ephemeral"
tar-ignore = "macos/Flutter/ephemeral"
# Build outputs, package caches and the extracted vendored SDK, all
# regenerated at build time from packaging/vendor/.
tar-ignore = "build"
tar-ignore = "dist"
tar-ignore = ".dart_tool"
tar-ignore = ".flutter"
tar-ignore = ".pub-cache"
tar-ignore = "debian/.home"
# The snap is built and published separately (packaging/SNAP.md).
tar-ignore = "snap"
tar-ignore = "parts"
tar-ignore = "stage"
tar-ignore = "prime"
tar-ignore = "*.snap"
# Local work: agent worktrees, logo design drafts, editor and VCS state.
tar-ignore = ".claude"
tar-ignore = "design"
tar-ignore = ".idea"
tar-ignore = ".vscode"
tar-ignore = ".DS_Store"
tar-ignore = ".git"
